# Copy to .env before deploy. Never commit .env.

DEBUG=False
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=your.domain.com
CSRF_TRUSTED_ORIGINS=https://your.domain.com
DB_INIT_PASSWORD=replace-with-strong-password

POSTGRES_DB=horilla_db
POSTGRES_USER=horilla_user
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgres://horilla_user:replace-with-strong-password@db:5432/horilla_db

REDIS_PASSWORD=replace-with-strong-password
REDIS_URL=redis://:replace-with-strong-password@redis:6379/0
